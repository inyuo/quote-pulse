{
  "name": "quote-pulse",
  "displayName": "行情脉冲 (QuotePulse)",
  "description": "行情脉冲（QuotePulse）：在 VS Code 里实时查看股票 & 基金行情数据",
  "version": "1.0.0",
  "author": "Nicky Lao <giscafer@outlook.com>",
  "bugs": {
    "url": "https://github.com/inyuo/quote-pulse/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/inyuo/quote-pulse"
  },
  "homepage": "https://github.com/inyuo/quote-pulse#readme",
  "qna": "https://github.com/inyuo/quote-pulse/discussions",
  "publisher": "inyuo",
  "license": "BSD-3-Clause",
  "keywords": [
    "stock",
    "fund",
    "QuotePulse",
    "股票",
    "基金",
    "行情脉冲",
    "同花顺",
    "东方财富",
    "天天基金"
  ],
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.59.0"
  },
  "enableProposedAPI": false,
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:quote-pulse.refreshStock",
    "onCommand:quote-pulse.stockWindVane",
    "onCommand:quote-pulse.refreshFund",
    "onView:leekFundView.fund",
    "onView:leekFundView.stock",
    "onView:leekFundView.news",
    "onView:leekFundView.binance",
    "onView:leekFundView.forex",
    "onView:leekFundView.settings",
    "onCommand:quote-pulse.toggleStatusBarIconVisibility"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leekFundMenu",
          "title": "行情脉冲",
          "icon": "resources/quote-pulse.svg"
        }
      ]
    },
    "views": {
      "leekFundMenu": [
        {
          "id": "leekFundView.fund",
          "name": "Fund"
        },
        {
          "id": "leekFundView.stock",
          "name": "Stock"
        },
        {
          "id": "leekFundView.news",
          "name": "资讯"
        },
        {
          "id": "leekFundView.binance",
          "name": "Binance",
          "visibility": "hidden"
        },
        {
          "id": "leekFundView.forex",
          "name": "Forex",
          "visibility": "hidden"
        },
        {
          "id": "leekFundView.settings",
          "visibility": "visible",
          "name": "Settings"
        }
      ]
    },
    "commands": [
      {
        "command": "quote-pulse.openAiConfig",
        "title": "Leek: 打开 AI 配置管理",
        "icon": "$(gear)"
      },
      {
        "command": "quote-pulse.customSetting",
        "title": "Leek: 个性定制"
      },
      {
        "command": "quote-pulse.viewFundRank",
        "title": "基金排行榜",
        "icon": {
          "light": "resources/light/rank.svg",
          "dark": "resources/dark/rank.svg"
        }
      },
      {
        "command": "quote-pulse.viewFundTrend",
        "title": "基金走势一览",
        "icon": {
          "light": "resources/light/trend.svg",
          "dark": "resources/dark/trend.svg"
        }
      },
      {
        "command": "quote-pulse.sortFund",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "quote-pulse.sortAmountFund",
        "title": "持仓金额升序/降序",
        "icon": {
          "light": "resources/light/amount-sort.svg",
          "dark": "resources/dark/amount-sort.svg"
        }
      },
      {
        "command": "quote-pulse.addFund",
        "title": "添加基金",
        "icon": "$(add)"
      },
      {
        "command": "quote-pulse.addFundGroup",
        "title": "添加分组",
        "icon": "$(diff-added)"
      },
      {
        "command": "quote-pulse.setFundAmount",
        "title": "设置基金持仓金额",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "quote-pulse.setFundTop",
        "title": "基金置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "quote-pulse.deleteFund",
        "title": "删除基金"
      },
      {
        "command": "quote-pulse.viewFundHistory",
        "title": "历史净值"
      },
      {
        "command": "quote-pulse.viewFundPosition",
        "title": "持仓信息"
      },
      {
        "command": "quote-pulse.removeFundGroup",
        "title": "删除分组"
      },
      {
        "command": "quote-pulse.renameFundGroup",
        "title": "修改分组名称"
      },
      {
        "command": "quote-pulse.refreshFund",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "quote-pulse.sortStock",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "quote-pulse.addStock",
        "title": "添加股票",
        "icon": "$(add)"
      },
      {
        "command": "quote-pulse.setStockPrice",
        "title": "设置股票成本价",
        "icon": {
          "light": "resources/light/amount.svg",
          "dark": "resources/dark/amount.svg"
        }
      },
      {
        "command": "quote-pulse.leekCenterView",
        "title": "行情中心",
        "icon": "$(home)"
      },
      {
        "command": "quote-pulse.refreshStock",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "quote-pulse.setStockTop",
        "title": "股票置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "quote-pulse.setStockUp",
        "title": "股票上移",
        "icon": "$(arrow-up)"
      },
      {
        "command": "quote-pulse.setStockDown",
        "title": "股票下移",
        "icon": "$(arrow-down)"
      },
      {
        "command": "quote-pulse.deleteStock",
        "title": "删除股票"
      },
      {
        "command": "quote-pulse.aiStockAnalysis",
        "title": "AI分析股票（A股搜狐/港股腾讯 前复权日线，含韭研公社个股新闻）",
        "icon": "$(lightbulb)"
      },
      {
        "command": "quote-pulse.viewStockFundFlow",
        "title": "资金动态（自选股主力净流入 / 分时资金流 / 行业资金流）"
      },
      {
        "command": "quote-pulse.stockFundFlowForStock",
        "title": "查看该股资金动态",
        "icon": "$(pulse)"
      },
      {
        "command": "quote-pulse.addStockToBar",
        "title": "添加至状态栏"
      },
      {
        "command": "quote-pulse.stockTrendPic",
        "title": "股票走势（图片版）"
      },
      {
        "command": "quote-pulse.viewFundFlow",
        "title": "资金流向",
        "icon": {
          "light": "resources/light/flow.svg",
          "dark": "resources/dark/flow.svg"
        }
      },
      {
        "command": "quote-pulse.refreshFollow",
        "title": "刷新资讯",
        "icon": "$(refresh)"
      },
      {
        "command": "quote-pulse.addBinancePair",
        "title": "添加交易对",
        "icon": "$(add)"
      },
      {
        "command": "quote-pulse.deletePair",
        "title": "删除交易对"
      },
      {
        "command": "quote-pulse.refreshBinance",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "quote-pulse.setPairTop",
        "title": "交易对置顶",
        "icon": {
          "light": "resources/light/top.svg",
          "dark": "resources/dark/top.svg"
        }
      },
      {
        "command": "quote-pulse.refreshForex",
        "title": "刷新数据",
        "icon": "$(refresh)"
      },
      {
        "command": "quote-pulse.toggleStatusBarVisibility",
        "title": "行情脉冲: Toggle Status Bar Visibility"
      },
      {
        "command": "quote-pulse.toggleStatusBarIconVisibility",
        "title": "行情脉冲: Toggle Status Bar Icon Visibility"
      },
      {
        "command": "quote-pulse.toggleFundBarVisibility",
        "title": "行情脉冲: Toggle Fund Bar Visibility"
      },
      {
        "command": "quote-pulse.toggleStockBarVisibility",
        "title": "行情脉冲: Toggle Stock Bar Visibility"
      },
      {
        "command": "quote-pulse.binanceSort",
        "title": "升序/降序/不排序",
        "icon": {
          "light": "resources/light/sort.svg",
          "dark": "resources/dark/sort.svg"
        }
      },
      {
        "command": "quote-pulse.stockWindVane",
        "title": "选股风向标",
        "icon": "$(graph)"
      },
      {
        "command": "quote-pulse.quantOpen",
        "title": "Leek: 量化面板"
      }
    ],
    "keybindings": [
      {
        "command": "quote-pulse.toggleStatusBarVisibility",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "quote-pulse.viewFundTrend",
          "when": "view == leekFundView.fund",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.viewFundRank",
          "when": "view == leekFundView.fund",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.refreshFund",
          "when": "view == leekFundView.fund",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.sortFund",
          "when": "view == leekFundView.fund",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.sortAmountFund",
          "when": "view == leekFundView.fund",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.addFundGroup",
          "when": "view == leekFundView.fund",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.setFundAmount",
          "when": "view == leekFundView.fund",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.refreshStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.sortStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.addStock",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.viewFundFlow",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.leekCenterView",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.setStockPrice",
          "when": "view == leekFundView.stock",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.refreshFollow",
          "when": "view == leekFundView.news",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.refreshBinance",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.addBinancePair",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.binanceSort",
          "when": "view == leekFundView.binance",
          "group": "navigation"
        },
        {
          "command": "quote-pulse.refreshForex",
          "when": "view == leekFundView.forex",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "quote-pulse.viewFundHistory",
          "when": "view == leekFundView.fund && viewItem != category",
          "group": "group2"
        },
        {
          "command": "quote-pulse.viewFundPosition",
          "when": "view == leekFundView.fund && viewItem != category",
          "group": "group2"
        },
        {
          "command": "quote-pulse.setFundTop",
          "when": "view == leekFundView.fund && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "quote-pulse.setFundTop",
          "when": "view == leekFundView.fund && viewItem != category  && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "quote-pulse.addFund",
          "when": "view == leekFundView.fund && viewItem == category",
          "group": "inline"
        },
        {
          "command": "quote-pulse.deleteFund",
          "when": "view == leekFundView.fund && viewItem != category",
          "group": "group4"
        },
        {
          "command": "quote-pulse.removeFundGroup",
          "when": "view == leekFundView.fund && viewItem == category",
          "group": "group7"
        },
        {
          "command": "quote-pulse.renameFundGroup",
          "when": "view == leekFundView.fund && viewItem == category",
          "group": "group7"
        },
        {
          "command": "quote-pulse.setStockTop",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "quote-pulse.setStockUp",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "quote-pulse.setStockDown",
          "when": "view == leekFundView.stock && viewItem != category  && viewItem!=nodata",
          "group": "group1"
        },
        {
          "command": "quote-pulse.stockTrendPic",
          "when": "view == leekFundView.stock  && viewItem != category && viewItem!=nodata",
          "group": "group2"
        },
        {
          "command": "quote-pulse.setStockTop",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "quote-pulse.setStockUp",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "quote-pulse.setStockDown",
          "when": "view == leekFundView.stock && viewItem != category && viewItem!=nodata",
          "group": "inline"
        },
        {
          "command": "quote-pulse.aiStockAnalysis",
          "when": "view == leekFundView.stock && (viewItem == aStock || viewItem == hkStock)",
          "group": "inline"
        },
        {
          "command": "quote-pulse.stockFundFlowForStock",
          "when": "view == leekFundView.stock && viewItem == aStock",
          "group": "group3"
        },
        {
          "command": "quote-pulse.deleteStock",
          "when": "view == leekFundView.stock  && viewItem != category",
          "group": "group5"
        },
        {
          "command": "quote-pulse.addStockToBar",
          "when": "view == leekFundView.stock  && viewItem != category",
          "group": "group6"
        },
        {
          "command": "quote-pulse.deletePair",
          "when": "view == leekFundView.binance  && viewItem != category",
          "group": "group0"
        },
        {
          "command": "quote-pulse.setPairTop",
          "when": "view == leekFundView.binance",
          "group": "inline"
        },
        {
          "command": "quote-pulse.setPairTop",
          "when": "view == leekFundView.binance",
          "group": "group1"
        }
      ]
    },
    "configuration": {
      "properties": {
        "quote-pulse.stocks": {
          "type": "array",
          "default": [
            "sh000001",
            "sh000300",
            "sh000016",
            "sh000688",
            "hk03690",
            "hk00700",
            "usr_ixic",
            "usr_dji",
            "usr_inx",
            "nf_IF0",
            "nf_IH0",
            "nf_IC0",
            "nf_IM0",
            "hf_OIL",
            "hf_CHA50CFD"
          ],
          "description": "配置需要监控的股票代码（建议通过界面新增）"
        },
        "quote-pulse.stockPrice": {
          "type": "object",
          "default": {},
          "description": "股票持仓金额（不建议手填，格式错误影响功能）"
        },
        "quote-pulse.stockHeldTipShow": {
          "type": "boolean",
          "default": false,
          "description": "是否开启股票持仓提示"
        },
        "quote-pulse.funds": {
          "type": "array",
          "default": [
            [
              "001632",
              "420009",
              "320007",
              "003096",
              "001102",
              "003885",
              "001071",
              "005963"
            ]
          ],
          "description": "配置需要监控的基金代码（建议通过界面新增）"
        },
        "quote-pulse.fundGroups": {
          "type": "array",
          "default": [
            "我的基金"
          ],
          "description": "配置基金分组名称（建议通过界面新增）"
        },
        "quote-pulse.binance": {
          "type": "array",
          "default": [
            "BTC_USDT",
            "ETH_USDT",
            "EOS_USDT"
          ],
          "description": "配置需要监控的交易对（建议通过界面新增）"
        },
        "quote-pulse.dataApiBaseUrl": {
          "type": "string",
          "default": "http://124.71.128.214:8800",
          "description": "数据服务地址（默认已指向自建服务）。服务不可用时，需登录的数据直接显示空态"
        },
        "quote-pulse.dataApiKey": {
          "type": "string",
          "default": "",
          "description": "数据服务 API Key（必填，取服务端 /etc/qp-data-service.env 中的 QP_API_KEY）"
        },
        "quote-pulse.stocksRemind": {
          "type": "object",
          "description": "股票涨跌提醒，支持价格、涨跌幅。"
        },
        "quote-pulse.statusBarStock": {
          "type": "array",
          "default": [
            "sh000001"
          ],
          "description": "状态栏展示的股票（建议通过界面选择设置，必须是在股票代码已设置存在）"
        },
        "quote-pulse.interval": {
          "type": "number",
          "default": 5000,
          "description": "配置轮询请求最新数据的时间间隔，单位：毫秒（最小轮询间隔是3秒）"
        },
        "quote-pulse.riseColor": {
          "type": "string",
          "default": "white",
          "description": "股票涨的颜色"
        },
        "quote-pulse.fallColor": {
          "type": "string",
          "default": "#C9AD06",
          "description": "股票跌的颜色"
        },
        "quote-pulse.hideFundBarItem": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏基金状态栏"
        },
        "quote-pulse.hideStatusBarStock": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏股票状态栏"
        },
        "quote-pulse.hideStatusBar": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏"
        },
        "quote-pulse.hideStatusBarIcon": {
          "type": "boolean",
          "default": false,
          "description": "是否隐藏状态栏图标"
        },
        "quote-pulse.fundAmount": {
          "type": "object",
          "default": {},
          "description": "基金持仓金额（不建议手填，格式错误影响功能）"
        },
        "quote-pulse.showEarnings": {
          "type": "number",
          "default": 1,
          "description": "显示/隐藏盈亏（1显示，0隐藏）"
        },
        "quote-pulse.iconType": {
          "type": "string",
          "default": "arrow",
          "description": "基金&股票涨跌图标（目前支持两种：arrow 和 food）"
        },
        "quote-pulse.fundSort": {
          "type": "number",
          "default": 0,
          "description": "基金排序方式(0正常、1涨跌升序、-1涨跌倒序、2持仓金额升序、-2持仓金额降序)"
        },
        "quote-pulse.fundAmountSort": {
          "type": "string",
          "default": "default",
          "description": "基金持仓金额设置界面排序方式(default默认、earningsDesc收益率降序、earningsAsc收益率升序)"
        },
        "quote-pulse.stockSort": {
          "type": "number",
          "default": 0,
          "description": "股票排序方式(0正常、1升序、-1倒序)"
        },
        "quote-pulse.stockRemindSwitch": {
          "type": "number",
          "default": 1,
          "description": "打开/关闭提醒（1打开，0关闭）"
        },
        "quote-pulse.stockKLineChartSwitch": {
          "type": "number",
          "default": 0,
          "description": "筹码分布K线图/常规k线图（1筹码分布K线图，0常规k线图）"
        },
        "quote-pulse.labelFormat": {
          "type": "object",
          "default": {
            "statusBarLabelFormat": "「${name}」${price}  ${icon}（${percent}）",
            "sidebarStockLabelFormat": "${icon|padRight|4}${percent|padRight|11}${price|padRight|15}「${name}」",
            "sidebarFundLabelFormat": "${icon|padRight|4}${percent|padRight}「${name}」${earnings} ${time}"
          },
          "description": "修改底部状态栏、侧栏的显示格式。\n"
        },
        "quote-pulse.immersiveBackground": {
          "type": "boolean",
          "default": true,
          "description": "沉浸式背景（仅适配暗色主题）"
        },
        "investment-monitor.expandAStock": {
          "type": "boolean",
          "default": true,
          "description": "默认展开A股"
        },
        "quote-pulse.expandHKStock": {
          "type": "boolean",
          "default": false,
          "description": "默认展开港股"
        },
        "quote-pulse.expandUSStock": {
          "type": "boolean",
          "default": false,
          "description": "默认展开美股"
        },
        "quote-pulse.aiConfig": {
          "type": "object",
          "default": {
            "apiKey": "",
            "baseUrl": "",
            "model": ""
          },
          "description": "AI助手配置（OpenAI API密钥、基础URL和模型名称）"
        },
        "quote-pulse.aiStockHistoryRange": {
          "type": "string",
          "default": "3m",
          "enum": [
            "1y",
            "6m",
            "3m",
            "1m",
            "1w"
          ],
          "enumDescriptions": [
            "1年",
